<%- include("partials/header.ejs") %>

<!-- Search bar component (Using GET method for query parameter persistence) -->
<section class="search-section">
    <form action="/search" method="GET" class="search-form">
        <input 
            type="text" 
            name="plantName" 
            placeholder="Search plant name (e.g., Oak, Rose, Sunflower)..." 
            value="<%= locals.searchQuery ? searchQuery : '' %>"
            required
        >
        <button type="submit">Search</button>
    </form>
</section>

<% if (locals.error) { %>
    <div class="error-banner">
        <p>⚠️ <%= error %></p>
    </div>
<% } %>

<!-- Plant Grid -->
<section class="plant-grid">
    <% if (locals.plants && plants.length > 0) { %>
        <% plants.forEach(plant => { %>
            <div class="plant-card">
                <% if (plant.image_url) { %>
                    <img src="<%= plant.image_url %>" alt="<%= plant.common_name || plant.scientific_name %>">
                <% } else { %>
                    <div class="placeholder-img">No Image Available</div>
                <% } %>

                <div class="card-content">
                    <h2><%= plant.common_name ? plant.common_name : plant.scientific_name %></h2>
                    <p class="scientific-name"><i><%= plant.scientific_name %></i></p>

                    <div class="details">
                        <% if (plant.family_common_name || plant.family) { %>
                            <p><strong>Family:</strong> <%= plant.family_common_name || plant.family %></p>
                        <% } %>
                    </div>

                    <!-- Link to individual plant detail page -->
                    <a href="/plant/<%= plant.id %>" class="btn-detail">View Details →</a>
                </div>
            </div>
        <% }) %>
    <% } else if (!locals.error) { %>
        <p class="no-results">No plants found. Try another search term!</p>
    <% } %>
</section>

<!-- Pagination Controls -->
<% if (locals.plants && plants.length > 0) { %>
    <div class="pagination">
        <!-- Previous Page Button -->
        <% if (currentPage > 1) { %>
            <a 
                href="<%= searchQuery ? `/search?plantName=${searchQuery}&page=${currentPage - 1}` : `/?page=${currentPage - 1}` %>" 
                class="page-btn"
            >
                ← Previous
            </a>
        <% } %>

        <span class="page-num">Page <%= currentPage %></span>

        <!-- Next Page Button -->
        <a 
            href="<%= searchQuery ? `/search?plantName=${searchQuery}&page=${currentPage + 1}` : `/?page=${currentPage + 1}` %>" 
            class="page-btn"
        >
            Next →
        </a>
    </div>
<% } %>

<%- include("partials/footer.ejs") %>