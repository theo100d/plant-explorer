<%- include("partials/header.ejs") %>

<!-- Search Bar Form (GET request maintains search terms in URL during pagination) -->
<section class="search-section">
    <form action="/search" method="GET" class="search-form">
        <input 
            type="text" 
            name="plantName" 
            placeholder="Search plant name (e.g., Oak, Rose, Sunflower)..." 
            value="<%= locals.searchQuery ? searchQuery : '' %>"
            required
        >
        <button type="submit">Search</button>
    </form>
</section>

<!-- Error Alert Banner -->
<% if (locals.error) { %>
    <div class="error-banner">
        <p>⚠️ <%= error %></p>
    </div>
<% } %>

<!-- Plant Cards Display Grid -->
<section class="plant-grid">
    <% if (locals.plants && plants.length > 0) { %>
        <!-- Iterate through array of plant objects -->
        <% plants.forEach(plant => { %>
            <div class="plant-card">
                <!-- Check if plant has an image; fallback to local PNG image if missing -->
                <% if (plant.image_url) { %>
                    <img src="<%= plant.image_url %>" alt="<%= plant.common_name || plant.scientific_name %>">
                <% } else { %>
                    <img src="/images/no-image.png" alt="No Image Available" class="placeholder-fallback">
                <% } %>

                <div class="card-content">
                    <h2><%= plant.common_name ? plant.common_name : plant.scientific_name %></h2>
                    <p class="scientific-name"><i><%= plant.scientific_name %></i></p>

                    <div class="details">
                        <% if (plant.family_common_name || plant.family) { %>
                            <p><strong>Family:</strong> <%= plant.family_common_name || plant.family %></p>
                        <% } %>
                    </div>

                    <!-- Button routing to individual plant details page -->
                    <a href="/plant/<%= plant.id %>" class="btn-detail">View Details →</a>
                </div>
            </div>
        <% }) %>
    <% } else if (!locals.error) { %>
        <p class="no-results">No plants found matching your search. Try another query!</p>
    <% } %>
</section>

<!-- Pagination Controls -->
<% if (locals.plants && plants.length > 0) { %>
    <div class="pagination">
        <!-- Previous Button: Shows only if current page is greater than 1 -->
        <% if (currentPage > 1) { %>
            <a 
                href="<%= searchQuery ? `/search?plantName=${searchQuery}&page=${currentPage - 1}` : `/?page=${currentPage - 1}` %>" 
                class="page-btn"
            >
                ← Previous
            </a>
        <% } %>

        <!-- Displays current page and total available pages -->
        <span class="page-num">Page <%= currentPage %> of <%= totalPages %></span>

        <!-- Next Button: Shows only if current page is less than total pages -->
        <% if (currentPage < totalPages) { %>
            <a 
                href="<%= searchQuery ? `/search?plantName=${searchQuery}&page=${currentPage + 1}` : `/?page=${currentPage + 1}` %>" 
                class="page-btn"
            >
                Next →
            </a>
        <% } %>
    </div>
<% } %>

<%- include("partials/footer.ejs") %>